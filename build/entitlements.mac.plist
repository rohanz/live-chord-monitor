<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's V8 engine needs JIT / writable-executable memory under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!--
    Deliberately NOT present: com.apple.security.cs.disable-library-validation.
    It is only needed for unsigned native modules, and the asar ships no native code (the renderer
    bundle is pure JS). Granting it would let an attacker inject an unsigned dylib into this signed,
    hardened-runtime process.
  -->

</dict>
</plist>
